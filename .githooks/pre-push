#!/usr/bin/env bash
#
# Pre-push for this public repo: a pushed branch is public the moment it lands,
# so this is the real gate. Runs extra/guard/public-guard over every commit
# being pushed that the remote does not have yet: added lines and messages.
# Bypass once with `git push --no-verify`.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

zero="0000000000000000000000000000000000000000"
remote="$1"
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue                 # deleting a branch
  if [[ "$remote_sha" == "$zero" ]]; then
    revs=("$local_sha" --not --remotes="$remote")            # new branch: what the remote lacks
  else
    revs=("$remote_sha..$local_sha")
  fi
  extra/guard/public-guard --revs "${revs[@]}" || status=1
done
exit "$status"
