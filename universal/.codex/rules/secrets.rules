# Stowed from dotfiles (universal/.codex/rules). Commands that print decrypted secrets, which would
# land in the session transcript. Codex refuses them; running with secrets (sudsy run, op run,
# sops exec-env) stays allowed. The Claude Code counterpart is ~/.claude/hooks/secret-guard.
# shortcut: prefix rules only see the leading tokens, so `sops --output x -d` or a wrapper script
# gets past them; the Claude hook matches more shapes.
prefix_rule(pattern=["sudsy", ["cat", "json", "get"]], decision="forbidden", justification="prints decrypted secrets into the transcript; use sudsy run <env> -- cmd")
prefix_rule(pattern=["op", ["read", "inject"]], decision="forbidden", justification="prints secrets into the transcript; use op run")
prefix_rule(pattern=["sops", ["-d", "--decrypt", "decrypt"]], decision="forbidden", justification="prints decrypted secrets into the transcript; use sops exec-env")
prefix_rule(pattern=["age", ["-d", "--decrypt"]], decision="forbidden", justification="prints decrypted secrets into the transcript")
