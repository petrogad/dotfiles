#!/usr/bin/env bash
# PreToolUse hook for Bash: refuses commands that print decrypted secrets, since whatever a
# command prints lands in the session transcript, its logs and any summary built from it.
# Covered: sudsy cat/json/get, op read/inject, op item get --reveal, sops -d/--decrypt/decrypt,
# age -d/--decrypt. Running with secrets (sudsy run, op run, sops exec-env) stays allowed.
#
# Denies rather than asks: the docs do not say an "ask" still prompts in bypass-permissions
# mode, which is how these sessions run, and a guard that is silently skipped guards nothing.
# shortcut: matches the command text at command positions (start, after ; & | ( or $( ),
# so an alias, a script or eval that decrypts gets past it; a real sandbox would close that.
set -euo pipefail

input=$(cat)
[ "$(jq -r '.tool_name // empty' <<<"$input")" = "Bash" ] || exit 0
cmd=$(jq -r '.tool_input.command // empty' <<<"$input")

start='(^|[;&|(`]|\$\()[[:space:]]*([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*(sudo[[:space:]]+)?'
secret='(sudsy[[:space:]]+(cat|json|get)|op[[:space:]]+(read|inject)|op[[:space:]]+item[[:space:]]+get[^;&|]*--reveal|sops[[:space:]]+([^;&|]*[[:space:]])?(-d|--decrypt|decrypt)([[:space:]]|$)|age[[:space:]]+([^;&|]*[[:space:]])?(-d|--decrypt)([[:space:]]|$))'

if grep -Eq "$start$secret" <<<"$cmd"; then
  jq -n '{hookSpecificOutput: {
    hookEventName: "PreToolUse",
    permissionDecision: "deny",
    permissionDecisionReason: "secret-guard: this command prints decrypted secrets, which would land in the transcript. Use the secret without printing it (sudsy run <env> -- cmd, op run, sops exec-env). If a person needs to see the value, tell them the command to run in their own terminal, not through this session."
  }}'
fi
exit 0
